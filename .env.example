# Ephemeral State Store: Serverless Upstash Redis (Freeze, Idempotency, Rate Limits, OTP)
UPSTASH_REDIS_REST_URL=https://CHANGE_ME_UPSTASH_REDIS_URL.upstash.io
UPSTASH_REDIS_REST_TOKEN=CHANGE_ME_GENERATE_UPSTASH_TOKEN

# Durable State Store: Supabase (Email-to-Wallet Identity Mapping & Audit Log Records)
NEXT_PUBLIC_SUPABASE_URL=https://CHANGE_ME_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL
SUPABASE_SERVICE_ROLE_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL

# Meirei Engine Configuration
MEIREI_CHAIN=xlayer
MEIREI_MOCK_ONCHAINOS=0
MEIREI_WALLET=0x7f17d6224e7d48606598732c3f511412b5c1e922

# Security & 2FA HMAC Secret (Generate using: openssl rand -base64 48; min 32 bytes required in production)
OTP_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_48

# Multi-Channel Webhook Verification & Bot Tokens
TELEGRAM_BOT_TOKEN=CHANGE_ME_BOTFATHER_TOKEN
META_WHATSAPP_VERIFY_TOKEN=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_48
META_WHATSAPP_APP_SECRET=CHANGE_ME_META_APP_SECRET
META_WHATSAPP_API_TOKEN=CHANGE_ME_WHATSAPP_CLOUD_API_TOKEN
